{
  "name": "@allurereport/aql",
  "version": "3.22.1",
  "description": "Allure Query Language implementation in TypeScript",
  "keywords": [
    "allure",
    "aql",
    "query language"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json",
    "clean": "rimraf ./dist",
    "test": "rimraf out && vp test run",
    "test:unit": "yarn test",
    "lint": "vp lint --import-plugin src test features stories",
    "lint:fix": "vp lint --import-plugin --fix src test features stories"
  },
  "devDependencies": {
    "@allurereport/common-config": "3.22.1",
    "@types/node": "^20",
    "@vitest/coverage-istanbul": "5.0.4",
    "@vitest/runner": "^2",
    "@vitest/snapshot": "5.0.4",
    "allure-js-commons": "^3",
    "allure-vitest": "^3",
    "rimraf": "^6",
    "tslib": "^2",
    "typescript": "^5",
    "vite": "@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0",
    "vitest": "5.0.4"
  }
}