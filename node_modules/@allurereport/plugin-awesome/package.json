{
  "name": "@allurereport/plugin-awesome",
  "version": "3.22.1",
  "description": "Allure Awesome Plugin – brand new HTML report with modern design and new features",
  "keywords": [
    "allure",
    "html",
    "plugin",
    "report",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "files": [
    "./dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json && node ../../scripts/pack-report-static.mjs ../web-awesome/dist/multi ./dist/static/report.tar --allow-chunks",
    "clean": "rimraf ./dist",
    "test": "rimraf out && vp test run",
    "test:unit": "yarn test",
    "lint": "vp lint --import-plugin src test features stories",
    "lint:fix": "vp lint --import-plugin --fix src test features stories"
  },
  "dependencies": {
    "@allurereport/charts-api": "3.22.1",
    "@allurereport/core-api": "3.22.1",
    "@allurereport/git": "3.22.1",
    "@allurereport/plugin-api": "3.22.1",
    "@allurereport/web-commons": "3.22.1",
    "d3-shape": "^3.2.0",
    "handlebars": "4.7.10",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@allurereport/common-config": "3.22.1",
    "@allurereport/web-awesome": "3.22.1",
    "@types/d3-shape": "^3.1.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20",
    "@vitest/coverage-istanbul": "5.0.4",
    "@vitest/runner": "^2",
    "allure-js-commons": "^3",
    "allure-vitest": "^3",
    "rimraf": "^6",
    "typescript": "^5",
    "vite": "@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0",
    "vitest": "5.0.4"
  }
}